# ── Infrastructure ────────────────────────
POSTGRES_DB=kagent
POSTGRES_USER=kagent
POSTGRES_PASSWORD=change-me-locally

# ── Services Ports ────────────────────────
GATEWAY_PORT=8080
CONTROL_PLANE_PORT=8100
REASONING_PORT=8200
RUNTIME_PORT=8300
PIPELINE_PORT=8400
OBSERVABILITY_PORT=8500

# ── Gateway Settings ──────────────────────
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_MAX_REQUESTS=120

# ── Authentication ────────────────────────
JWT_SECRET=change-me-production-min-32-chars

# ── Model Providers (optional) ────────────
OPENCODE_GO_ENDPOINT=http://localhost:20127
OPENCODE_GO_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# ── Object Storage ────────────────────────
S3_ACCESS_KEY=kagent-local
S3_SECRET_KEY=change-me-locally

# ── Rust Logging ──────────────────────────
RUST_LOG=info
