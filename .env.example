# ── Infrastructure ────────────────────────
POSTGRES_DB=kagent
POSTGRES_USER=kagent
POSTGRES_PASSWORD=change-me-locally

# ── Public Gateway Port ───────────────────
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
KAGENT_DOMAIN=kagent.example.com
BACKUP_DIR=./backups

# ── Event Streaming ───────────────────────
NATS_URL=nats://localhost:4222

# ── Gateway Settings ──────────────────────
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_MAX_REQUESTS=120

# ── Authentication ────────────────────────
JWT_SECRET=change-me-production-min-32-chars
KAGENT_SERVICE_SECRET=change-me-unique-service-secret

# ── Model Providers (optional) ────────────
OPENCODE_GO_ENDPOINT=http://host.docker.internal:20127
OPENCODE_GO_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional account pools. Numbered keys become account IDs oc-1, xai-1, oai-1.
# OPENCODE_GO_1_API_KEY=
# OPENCODE_GO_2_API_KEY=
# XAI_1_API_KEY=
# OPENAI_1_API_KEY=
# POOL_DEFAULT=oc-1,xai-1,oai-1
# POOL_ORCHESTRATOR=oai-1
# POOL_SUBAGENTS=oc-1,xai-1

# ── Object Storage ────────────────────────
S3_ACCESS_KEY=kagent-local
S3_SECRET_KEY=change-me-locally

# ── Rust Logging ──────────────────────────
RUST_LOG=info
