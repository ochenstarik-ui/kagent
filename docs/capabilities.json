  "evidence_checks": {
    "typecheck": { "type": "command", "command": "pnpm typecheck", "allow_failure": false },
    "unit_tests": { "type": "command", "command": "pnpm test", "allow_failure": false },
    "build": { "type": "command", "command": "pnpm build", "allow_failure": false },
    "rust_tests": { "type": "command", "command": "cargo test --manifest-path services/gateway/Cargo.toml", "allow_failure": false },
    "rust_fmt": { "type": "command", "command": "cargo fmt --manifest-path services/gateway/Cargo.toml --check", "allow_failure": false },
    "rust_clippy": { "type": "command", "command": "cargo clippy --manifest-path services/gateway/Cargo.toml --all-targets -- -D warnings", "allow_failure": false },
    "integration_tests": { "type": "command", "command": "python tests/integration/test_pg.py", "allow_failure": false },
    "repo_validation": { "type": "command", "command": "python scripts/validate_repository.py", "allow_failure": false },
    "drift_check": { "type": "command", "command": "python scripts/drift_check.py", "allow_failure": false },
    "eval_suite": { "type": "command", "command": "python scripts/eval_suite.py --replay", "allow_failure": false },
    "build": { "type": "command", "command": "pnpm build", "allow_failure": false },
    "node_ci": { "type": "ci", "job": "node", "allow_failure": false },
    "rust_ci": { "type": "ci", "job": "rust", "allow_failure": false },
    "python_ci": { "type": "ci", "job": "python", "allow_failure": false },
    "measurability_ci": { "type": "ci", "job": "measurability", "allow_failure": false },
    "nats_events_ci": { "type": "ci", "job": "nats-events", "allow_failure": false },
    "compose_syntax": { "type": "command", "command": "docker compose config -q", "allow_failure": false }
  },
  "route_table": {
    "gateway": [
      "GET /health/live",
      "ALL /api/control-plane/*",
      "ALL /api/reasoning/*",
      "ALL /health"
    ],
    "control-plane": [
      "GET /health/live",
      "GET /health/ready",
      "GET /v1/projects",
      "POST /v1/projects",
      "GET /v1/projects/:id",
      "PATCH /v1/projects/:id",
      "GET /v1/tasks",
      "POST /v1/tasks",
      "GET /v1/tasks/:id",
      "PATCH /v1/tasks/:id/status",
      "GET /v1/audit",
      "GET /v1/system/info",
      "POST /v1/auth/register",
      "POST /v1/auth/login",
      "POST /v1/auth/refresh",
      "POST /v1/auth/logout",
      "POST /v1/auth/logout-all",
      "GET /v1/auth/whoami",
      "GET /v1/auth/sessions"
    ],
    "reasoning-engine": [
      "GET /health/live",
      "GET /health/ready",
      "GET /v1/models",
      "POST /v1/decide",
      "POST /v1/execute",
      "GET /v1/telemetry"
    ],
    "agent-runtime": [
      "GET /health/live",
      "GET /v1/tools",
      "POST /v1/contexts",
      "POST /v1/execute",
      "POST /v1/run",
      "GET /v1/contexts/:task_id/events",
      "GET /v1/contexts/:task_id/status",
      "DELETE /v1/contexts/:task_id"
    ],
    "pipeline": [
      "GET /health/live",
      "POST /v1/pipelines/execute",
      "GET /v1/pipelines/:task_id",
      "GET /v1/pipelines"
    ],
    "observability": [
      "GET /health/live",
      "GET /v1/health",
      "GET /v1/metrics",
      "GET /v1/alerts",
      "POST /v1/metrics/record",
      "GET /v1/dashboard"
    ],
    "orchestrator": [
      "GET /health/live",
      "POST /v1/agents/register",
      "GET /v1/agents",
      "GET /v1/agents/available",
      "POST /v1/work",
      "GET /v1/work",
      "POST /v1/work/assign",
      "POST /v1/work/complete",
      "POST /v1/handoff",
      "GET /v1/stats"
    ],
    "auth": [
      "POST /v1/auth/totp/setup",
      "POST /v1/auth/totp/verify",
      "POST /v1/auth/totp/validate"
    ],
    "nats": [
      "publish",
      "subscribe"
    ]
  },
